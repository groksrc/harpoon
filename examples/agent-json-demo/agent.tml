harpoon: "1.1"
name: agent-json-demo
description: Demonstrates agent node with JSON structured output and telemetry streaming

nodes:
  input:
    type: input
    schema:
      topic:
        type: string
        description: The topic to summarize

  summarize:
    type: agent
    prompt: prompts/summarize.prompt
    execution_mode: cli
    max_turns: 1
    allowed_tools: "*"
    permission_mode: bypassPermissions

  output:
    type: output
    format: json

edges:
  input_to_summarize:
    from: input
    to: summarize
    mapping:
      topic: topic

  summarize_to_output:
    from: summarize
    to: output
    mapping:
      summary: summary
      keywords: keywords
